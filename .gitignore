# ==============================================================================
# Production-Grade .gitignore for Full-Stack Node.js / React (Vite) Applications
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL SECURITY RISK)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
*.pem
*.key
*.crt
*.pfx
*.p12
secrets.json

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.npm/

# ------------------------------------------------------------------------------
# 3. Build & Compilation Outputs
# ------------------------------------------------------------------------------
dist/
**/dist/
dist-ssr/
build/
bin/
obj/
out/
.output/
.vercel/
.netlify/

# ------------------------------------------------------------------------------
# 4. Cache Directories
# ------------------------------------------------------------------------------
.cache/
.vite/
**/node_modules/.vite/
.eslintcache
.stylelintcache
.prettiercache
.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. Logs & Debug Scripts
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
scratch/
test_*.js

# ------------------------------------------------------------------------------
# 6. IDE, Editors & OS System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors (VS Code, JetBrains, Visual Studio)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 7. Testing & Coverage Reports
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
playwright-report/
blob-report/
.playwright/
